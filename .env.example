# ---------------------------------------------------------------------------
# Pipeline A: Sygnal signal router
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Webhook edge (FastAPI receiver)
RECEIVER_HOST=0.0.0.0
RECEIVER_PORT=8080

# Shared secret used by Sygnal to sign webhook deliveries (HMAC-SHA256).
# Leave blank to disable verification (local testing only).
SYGNAL_WEBHOOK_SECRET=

# Header carrying the signature. Sygnal sends "sha256=<hex>" or bare "<hex>".
SYGNAL_SIGNATURE_HEADER=X-Sygnal-Signature

# Where the receiver forwards verified events for orchestration (n8n webhook).
# docker-compose exposes n8n at http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/pipeline-a
N8N_FORWARD_ATTEMPTS=3
N8N_FORWARD_TIMEOUT_SECONDS=10

# Host port the Postgres container binds to. Change to 5433 (or any free port)
# if a local Postgres already occupies 5432. Keep DATABASE_URL's port in sync.
POSTGRES_HOST_PORT=5432

# Postgres (docker-compose provisions this). Leave blank to use the in-memory store.
DATABASE_URL=postgresql://gtm:gtm@localhost:5432/gtm

# Notification sink for hot leads (Slack/Discord incoming webhook). Optional.
SLACK_WEBHOOK_URL=

# Routing thresholds (priority = composite score 0-100)
ROUTE_HOT_THRESHOLD=70
ROUTE_WARM_THRESHOLD=40
